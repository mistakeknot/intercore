{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://intercore.dev/contracts/cli/usage-observation.json",
  "properties": {
    "id": {
      "type": "string"
    },
    "provider": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "rate_limits",
        "account_usage",
        "local_usage"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "available",
        "partial",
        "unavailable",
        "error"
      ]
    },
    "reason": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "captured_at": {
      "type": "string"
    },
    "source_at": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "interval_start": {
      "oneOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    },
    "interval_end": {
      "oneOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    },
    "quota_bucket": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "quota_reset_at": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "counters": {
      "items": {
        "properties": {
          "name": {
            "type": "string"
          },
          "value": {
            "oneOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "unit": {
            "type": "string"
          },
          "semantics": {
            "type": "string"
          },
          "subset_of": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "value",
          "unit",
          "semantics",
          "subset_of"
        ]
      },
      "type": "array"
    },
    "identity": {
      "properties": {
        "native_thread_id": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "native_session_id": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "account": {
          "properties": {
            "coverage": {
              "type": "string",
              "enum": [
                "unknown",
                "incomplete",
                "complete"
              ]
            },
            "safe_ref": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "reasons": {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          "additionalProperties": false,
          "type": "object",
          "required": [
            "coverage",
            "safe_ref",
            "reasons"
          ]
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "native_thread_id",
        "native_session_id",
        "account"
      ]
    },
    "execution_refs": {
      "properties": {
        "dispatch_id": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "session_row_id": {
          "oneOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "run_id": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "task_id": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "dispatch_request_id": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "enrollment_id": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "execution_id": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "attempt_id": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "dispatch_id",
        "session_row_id",
        "run_id",
        "task_id",
        "dispatch_request_id",
        "enrollment_id",
        "execution_id",
        "attempt_id"
      ]
    },
    "payload_sha256": {
      "type": "string"
    },
    "supersedes": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "canonical_sha256": {
      "type": "string"
    },
    "inserted_at": {
      "type": "integer"
    }
  },
  "additionalProperties": false,
  "type": "object",
  "required": [
    "id",
    "provider",
    "source",
    "kind",
    "status",
    "reason",
    "captured_at",
    "source_at",
    "interval_start",
    "interval_end",
    "quota_bucket",
    "quota_reset_at",
    "counters",
    "identity",
    "execution_refs",
    "payload_sha256",
    "supersedes",
    "canonical_sha256",
    "inserted_at"
  ]
}
