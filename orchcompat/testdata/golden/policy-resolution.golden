=== flag alone
$ ic --json route dispatch --role=planning --policy=<SANDBOX>/sel/flag/routing.yaml
exit: 0
--- stdout
{
  "requested_role": "planning",
  "profile_ref": "planning-sol",
  "profile": {
    "model_identity": "gpt-6.1-sol",
    "role": "planning",
    "backend": "codex",
    "model": "gpt-6.1-sol",
    "reasoning_effort": "high",
    "service_tier": "standard",
    "fallbacks": [
      "routine-sonnet"
    ],
    "description": "Unelevated planning; Sol at high because Rule 6 bars Sol-medium from judgment roles"
  },
  "fallback_chain": [
    {
      "profile_ref": "routine-sonnet",
      "profile": {
        "model_identity": "claude-sonnet-5-5",
        "role": "routine-execution",
        "backend": "claude",
        "model": "claude-sonnet-5-5",
        "reasoning_effort": "high",
        "service_tier": "standard",
        "description": "Capacity fallback for routine execution when the Codex lane is out of usage"
      }
    }
  ],
